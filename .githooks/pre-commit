#!/bin/sh
# Pre-commit gate: run the review-enforced ban scanner (Q3) before every commit.
# It flags the four bans no clippy lint covers — lookup-shaped unwrap_or, inline
# #[expect], #[non_exhaustive] enums, and fabricated Default — with file:line,
# exiting non-zero so the commit is blocked until the root is fixed.
#
# Enable once per clone:  git config core.hooksPath .githooks
# CI runs the same `cargo xtask scan` step, so this hook is a fast local
# pre-flight, not the sole gate.
set -e

cargo xtask scan

# Anti-drift gate: data/*.json is GENERATED by tools/extract/. A hand-edit there
# is reverted by the next extractor run, silently — which is what happened to
# move_step_units and tick_duration_ms. This is the only gate that catches it,
# and it cannot live in CI: the extractors read `reference/openmu`, a gitignored
# clone CI does not have. So it runs here, on the machine where such an edit is
# actually made.
#
# Only when the commit touches generated data or its generators — it re-runs ten
# extractors and costs about a minute.
if git diff --cached --name-only | grep -qE '^(data/|tools/extract/)'; then
    set +e
    python3 tools/extract/verify.py
    status=$?
    set -e
    # Exit 2 is "reference/openmu absent" — cannot check. Not a failure, and
    # deliberately not silence either: say so rather than imply a clean run.
    if [ "$status" -eq 2 ]; then
        echo "pre-commit: data-drift gate skipped (see message above)"
    elif [ "$status" -ne 0 ]; then
        exit "$status"
    fi
fi
